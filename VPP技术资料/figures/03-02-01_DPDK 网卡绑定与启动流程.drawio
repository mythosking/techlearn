<mxfile host="app.diagrams.net" agent="VPP-DocGen" version="21.0.0" type="device"><diagram id="03-02-01" name="DPDK 网卡绑定与启动流程"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="417" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="1. 确认 PCI 地址与 NUMA&lt;br&gt;lspci / ethtool -i / numa_node" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=E6F1FB;strokeColor=185FA5;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="177.9" y="20.6" width="206.0" height="55.2" as="geometry"/></mxCell><mxCell id="s2" value="2. 开启 IOMMU 并加载驱动&lt;br&gt;modprobe vfio-pci / uio_pci_generic" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=E6F1FB;strokeColor=185FA5;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="163.4" y="109.6" width="235.0" height="55.2" as="geometry"/></mxCell><mxCell id="s3" value="3. 预留并挂载 Hugepages&lt;br&gt;hugepages-1048576kB / hugetlbfs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=E6F1FB;strokeColor=185FA5;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="175.1" y="198.5" width="211.6" height="55.2" as="geometry"/></mxCell><mxCell id="s4" value="4. 解绑内核驱动并绑定&lt;br&gt;driverctl / dpdk-devbind.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=E1F5EE;strokeColor=0F6E56;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="186.8" y="287.5" width="188.2" height="55.2" as="geometry"/></mxCell><mxCell id="s5" value="5. 编写 startup.conf&lt;br&gt;dpdk{} + cpu{}（完整参数见 04-01）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=E1F5EE;strokeColor=0F6E56;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="166.7" y="465.4" width="228.5" height="55.2" as="geometry"/></mxCell><mxCell id="s6" value="6. systemd 启动 vpp&lt;br&gt;ExecStartPre 就绪检查" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=E1F5EE;strokeColor=0F6E56;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="204.1" y="554.3" width="153.6" height="55.2" as="geometry"/></mxCell><mxCell id="s7" value="7. vppctl 验证接口与收发" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=FAEEDA;strokeColor=854F0B;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="195.7" y="643.3" width="170.4" height="41.2" as="geometry"/></mxCell><mxCell id="nic0" value="NIC-0 0000:3b:00.0&lt;br&gt;vfio-pci" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=EAF3DE;strokeColor=3B6D11;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="133.0" y="376.4" width="135.8" height="55.2" as="geometry"/></mxCell><mxCell id="nic1" value="NIC-1 0000:3b:00.1&lt;br&gt;vfio-pci" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=EAF3DE;strokeColor=3B6D11;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="293.1" y="376.4" width="135.8" height="55.2" as="geometry"/></mxCell><mxCell id="ok" value="接口 up / Rx-Tx 计数增长" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=EAF3DE;strokeColor=3B6D11;fontColor=#2C2C2A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="195.7" y="718.2" width="170.4" height="41.2" as="geometry"/></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;fontColor=#5F5E5A;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"/><mxPoint x="280.9" y="75.8" as="sourcePoint"/><mxPoint x="280.9" y="109.6" as="targetPoint"